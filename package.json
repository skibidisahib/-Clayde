{
  "name": "content-rewards-automation",
  "version": "1.0.0",
  "description": "Automated content repurposing and monetization platform",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "build": "npm run build:server && npm run build:client",
    "build:server": "echo 'Server ready'",
    "build:client": "cd client && npm run build",
    "client": "cd client && npm start"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "sqlite3": "^5.1.6",
    "multer": "^1.4.5-lts.1",
    "fluent-ffmpeg": "^2.1.2",
    "sharp": "^0.32.6",
    "cheerio": "^1.0.0-rc.12",
    "node-cron": "^3.0.2",
    "stripe": "^13.9.0",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
